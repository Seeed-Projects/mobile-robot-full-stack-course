[Unit]
Description=Configure and wake J401 CAN1 for the DM-H65 chassis (manual start)
After=network-pre.target
ConditionPathExists=/dev/gpiochip2

[Service]
Type=simple
ExecStartPre=-/usr/sbin/ip link set can1 down
ExecStartPre=/usr/sbin/ip link set can1 type can bitrate 1000000 berr-reporting on restart-ms 100
ExecStartPre=/usr/sbin/ip link set can1 txqueuelen 1000
ExecStartPre=/usr/sbin/ip link set can1 up
ExecStart=/usr/bin/gpioset --mode=signal gpiochip2 4=0
ExecStop=/usr/sbin/ip link set can1 down
Restart=on-failure
RestartSec=1

# No [Install] section: start manually after each boot.
