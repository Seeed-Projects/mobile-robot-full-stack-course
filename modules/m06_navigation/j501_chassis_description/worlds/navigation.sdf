<?xml version="1.0"?>
<sdf version="1.8">
  <world name="navigation">
    <physics name="default" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
    <gravity>0 0 -9.81</gravity>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.4 -0.5 -1</direction><cast_shadows>true</cast_shadows></light>
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="floor"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="floor"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><ambient>0.65 0.67 0.7 1</ambient><diffuse>0.65 0.67 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="test_obstacle">
      <static>true</static><pose>2 0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="box"><geometry><box><size>0.5 0.8 0.6</size></box></geometry></collision>
        <visual name="box"><geometry><box><size>0.5 0.8 0.6</size></box></geometry><material><ambient>0.7 0.3 0.15 1</ambient><diffuse>0.7 0.3 0.15 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
