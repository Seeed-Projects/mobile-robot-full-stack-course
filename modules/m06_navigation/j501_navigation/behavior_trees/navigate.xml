<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="4" name="NavigationRecovery">
      <PipelineSequence name="NavigationWithReplanning">
        <PlannerSelector selected_planner="{selected_planner}" default_planner="AStar" topic_name="planner_selector"/>
        <ControllerSelector selected_controller="{selected_controller}" default_controller="DWB" topic_name="controller_selector"/>
        <RateController hz="0.5">
          <ComputePathToPose goal="{goal}" path="{path}" planner_id="{selected_planner}"/>
        </RateController>
        <FollowPath path="{path}" controller_id="{selected_controller}"/>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence>
            <ClearEntireCostmap name="ClearLocal" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobal" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <Wait wait_duration="2"/>
          <Spin spin_dist="0.7"/>
          <BackUp backup_dist="0.15" backup_speed="0.05"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
