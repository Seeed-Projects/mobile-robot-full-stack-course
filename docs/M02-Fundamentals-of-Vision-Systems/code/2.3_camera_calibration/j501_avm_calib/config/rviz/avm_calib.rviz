Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /MarkerArray1
      Splitter Ratio: 0.5
    Tree Height: 400
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Normal Cell Count: 20
      Plane Cell Count: 20
      Cell Size: 0.25
      Line Style:
        Color: 128; 128; 128
      Plane: XY
      Offset:
        X: 0
        Y: 0
        Z: 0
      Reference Frame: <Fixed Frame>
    - Alpha: 0.8
      Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: 标定板角点(期望绿/实测红/误差黄)
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /calib/markers/boards
      Update Interval: 0
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: 地面网格标记
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /calib/markers/bev_ground
      Update Interval: 0
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Image
      Enabled: true
      Name: BEV 拼接
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /calib/bev/image
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Image
      Enabled: true
      Name: BEV 评估覆盖层
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /calib/bev/eval_image
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Image
      Enabled: false
      Name: front 去畸变
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /calib/undist/front
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Image
      Enabled: false
      Name: back 去畸变
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /calib/undist/back
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Image
      Enabled: false
      Name: left 去畸变
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /calib/undist/left
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Image
      Enabled: false
      Name: right 去畸变
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /calib/undist/right
      Value: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.25
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.8
Window Geometry:
  Height: 800
  Width: 1280
  X: 40
  Y: 40
  collapsed: false