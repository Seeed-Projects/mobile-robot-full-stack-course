<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bev_segmentation</name>
  <version>0.1.0</version>
  <description>M4.3 — TensorRT SegFormer semantic segmentation node (road/drivable masks)</description>
  <maintainer email="dev@example.com">ROS2 BEV Team</maintainer>
  <!-- MIT matches the sibling M4 packages (bev_detection, bev_tracking,
       bev_interfaces, m4_demo_bringup). This covers the CODE only: the
       SegFormer checkpoint is separately licensed, see
       models/m4/segmentation/LICENSE.md. -->
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_gmock</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
